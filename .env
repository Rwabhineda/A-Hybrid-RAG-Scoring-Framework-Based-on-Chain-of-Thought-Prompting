# ASEAN Legal Clause Scoring - Environment Variables
# Copy this file to .env and fill in your actual values

# API Provider Selection
# Options: "openai" (ChatGPT) or "deepseek"
API_PROVIDER=openai

# ChatGPT (OpenAI) API Configuration
# Required if API_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# DeepSeek API Configuration
# Required if API_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Optional: Override default config file
# SCORING_CONFIG=configs/gpt-4o.yaml

# Optional: Proxy configuration (if needed)
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

# Optional: HuggingFace cache directory
# HF_HOME=./data/hf_cache
